        <name>Validate Base Vacancies</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
	g_form.clearMessages();
      return;
   }

   var vacancies = g_form.getValue("vacancies_available_for_this_base");
   var vacanciesString = (vacancies || "0").toString();
   var availableVacancies = parseInt(vacanciesString, 10);

   g_form.clearMessages();
   g_form.hideFieldMsg("base");

   if (availableVacancies <= 0 ){
	g_form.showFieldMsg("base","The selected Base has no vacancies available, Please select another Base.", "error");
   }

   
   
}]]></script>
