        <script><![CDATA[function onSubmit() {
   //Type appropriate comment here, and begin script below
   var vacanciesStr = g_form.getValue("vacancies_available_for_this_base");
   var vacanciesAvailable = parseInt(vacanciesStr);
   var alreadyRegistered = g_form.getValue("already_registered");

   if(vacanciesAvailable < 1 || alreadyRegistered == 'true'){
	g_form.addErrorMessage("Invalid submission. Please check if have available vacancies and if you are not already registered to another base.");
	return false;
   }
   else{
	return true;
   }
   
}]]></script>
